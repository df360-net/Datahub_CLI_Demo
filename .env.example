# =====================================================================
# datahub_proxy_app1 — environment template
#
# Copy to `.env` and fill in the secrets. NEVER commit `.env` itself.
# Both the proxy (`python -m proxy`) and the CardCompass ETL
# (`python -m cardcompass.daily_load`) read from this same file.
# =====================================================================


# ---------------------------------------------------------------------
# DataHub upstream — used by the Auth Proxy to log in and forward
# ---------------------------------------------------------------------

# Upstream DataHub frontend (NOT the GMS port 8080 — sessions live at the frontend).
# Murphy lab default: http://192.168.0.16:9002
DATAHUB_URL=http://192.168.0.16:9002

# Credentials the proxy uses for POST /logIn at startup.
# NOTE: variable is DATAHUB_PW (not DATAHUB_PWD) — matches workplace .env.
DATAHUB_USER=<datahub-username>
DATAHUB_PW=<datahub-password>

# Proactive re-login cadence (minutes). Default 20.
SESSION_REFRESH_MINUTES=20

# Per-request timeout when the proxy calls upstream DataHub (seconds). Default 60.
UPSTREAM_TIMEOUT_SECONDS=60

# Verify upstream TLS cert. Keep `true` unless upstream is a known private host
# without a CA-signed cert. Murphy uses http:// (private LAN), so this only matters
# when targeting a real https:// DataHub at work.
UPSTREAM_VERIFY_TLS=true


# ---------------------------------------------------------------------
# Auth Proxy listener — local-only by design
# ---------------------------------------------------------------------

# Local port the proxy listens on.
PROXY_PORT=8080

# Bind address. MUST be 127.0.0.1 in normal operation — credentials never leave
# the host. Setting this to 0.0.0.0 requires PROXY_ALLOW_NON_LOOPBACK=1 below.
PROXY_BIND=127.0.0.1

# Safety override. Leave at 0. Set to 1 ONLY if you intentionally want the proxy
# reachable from other hosts (almost never the right answer).
PROXY_ALLOW_NON_LOOPBACK=0


# ---------------------------------------------------------------------
# MSSQL — used by the CardCompass ETL
# ---------------------------------------------------------------------

# Murphy MSSQL host + port. The app + proxy run on the dev workstation,
# the database lives on Murphy.
MSSQL_HOST=192.168.0.16
MSSQL_PORT=1433

# Database + login. DCFDBUSR has database-wide DML via db_datareader + db_datawriter
# (set up by db/00_create_user.sql, run as sa).
MSSQL_DATABASE=DCF_DB
MSSQL_USER=DCFDBUSR
MSSQL_PASSWORD=<dcfdbusr-password>

# ODBC driver name registered on the host running the ETL. Install
# "Microsoft ODBC Driver 18 for SQL Server" if pyodbc can't find it.
MSSQL_DRIVER=ODBC Driver 18 for SQL Server


# ---------------------------------------------------------------------
# CardCompass ETL — application settings
# ---------------------------------------------------------------------

# Where the daily card_auth_*.csv + card_post_*.csv files are dropped
# (by tools/generate_daily_file.py or, in production, an external system).
INBOUND_DIR=./data/inbound

# Where the ETL POSTs to DataHub. ALWAYS the local Auth Proxy — never
# DataHub GMS or frontend directly.
PROXY_URL=http://127.0.0.1:8080

# Value stamped on every DataHub payload's customProperties["source.app"].
# Stable across runs — downstream consumers (DF360 if used) route on it.
SOURCE_APP_NAME=CardCompass

# Firm-assigned Enterprise PID (4-5 chars), e.g. the company/application ID.
# Rides every dataset/column URN as DataHub's platformInstance qualifier:
#   urn:li:dataset:(urn:li:dataPlatform:mssql,<PID>.DCF_DB.CARD_STG.card_auth,PROD)
# and prefixes assertion URNs. Guarantees firm-wide URN uniqueness across the
# thousands of apps that push to DataHub.
ENTERPRISE_PID=CARDC


# ---------------------------------------------------------------------
# Logging (shared by proxy + ETL)
# ---------------------------------------------------------------------

LOG_LEVEL=INFO            # DEBUG / INFO / WARN / ERROR
LOG_FORMAT=text           # text / json
LOG_INCLUDE_BODIES=false  # DEBUG-only — never enable in shared environments
